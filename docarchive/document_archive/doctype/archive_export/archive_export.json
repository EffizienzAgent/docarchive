{
 "docstatus": 0,
 "doctype": "DocType",
 "engine": "InnoDB",
 "module": "Document Archive",
 "custom": 0,
 "name": "Archive Export",
 "autoname": "EXP-.YYYY.-.#####",
 "naming_rule": "Expression (old style)",
 "sort_field": "creation",
 "sort_order": "DESC",
 "states": [],
 "in_create": 1,
 "track_changes": 0,
 "field_order": [
  "status",
  "requested_by",
  "requested_at",
  "expires_at",
  "column_break_status",
  "progress",
  "total_documents",
  "exported_documents",
  "skipped_documents",
  "archive_size",
  "mismatches",
  "scope_section",
  "target_name",
  "own_company",
  "document_type",
  "column_break_scope",
  "date_from",
  "date_to",
  "counterparty_type",
  "counterparty",
  "files_section",
  "parts",
  "details_section",
  "mismatch_details",
  "error"
 ],
 "fields": [
