   "read_only": 1
  },
  {
   "fieldname": "own_company",
   "fieldtype": "Link",
   "label": "Own Company",
   "options": "Own Company",
   "read_only": 1
  },
  {
   "fieldname": "document_type",
   "fieldtype": "Link",
   "label": "Business Document Type",
   "options": "Business Document Type",
   "read_only": 1
  },
  {
   "fieldname": "column_break_scope",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "date_from",
   "fieldtype": "Date",
   "label": "From Date",
   "read_only": 1
